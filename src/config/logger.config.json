{
  "appenders": {
    "out": { "type": "stdout" },
    "api": {
      "type": "file",
      "filename": "logs/api.log",
      "maxLogSize": 10485760,
      "pattern": ".yyyy-MM-dd",
      "backups": 3,
      "compress": true
    }
  },
  "categories": {
    "default": { "appenders": ["out", "api"], "level": "all" },
    "API": { "appenders": ["out", "api"], "level": "all" }
  }
}